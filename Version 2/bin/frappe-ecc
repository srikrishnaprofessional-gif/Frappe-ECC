#!/usr/bin/env bash
# Launcher for the frappe-ecc CLI. Works from a git clone or an installed Claude Code plugin.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
for py in python3 python; do
	if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
		PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m frappe_ecc "$@"
	fi
done
echo "frappe-ecc needs Python 3.10 or later on PATH" >&2
exit 1
